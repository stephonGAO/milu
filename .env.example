# ════════════════════════════════════════════════════════════
# milu 环境变量示例 —— 只放「密钥」与「必要的进程级开关」。
# 复制为 .env 后按需填写；可选项保持注释态即用默认行为。
# ⚠️ .env 含密钥，确保已在 .gitignore 中，切勿提交到版本库。
#
# 📌 可调参数（provider/model/mode、运行限额、压缩、资源池等）不在这里，
#    统一放 config/milu.json（项目级默认）+ ~/.milu/config.json（用户级覆盖）。
#    查看/修改：`milu config show` / `milu config set agent.max_turns 50` / `milu config init`
# ════════════════════════════════════════════════════════════

# ── 1. LLM 厂商 API Key（按需配置，命名规则 {PROVIDER}_API_KEY）──
QWEN_API_KEY=sk-xxx
KIMI_API_KEY=sk-xxx
GLM_API_KEY=xxx
DEEPSEEK_API_KEY=sk-xxx
MINIMAX_API_KEY=xxx
DOUBAO_API_KEY=ark-cn-beijing-xxx
OPENAI_API_KEY=sk-xxx
GEMINI_API_KEY=xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# ── 2. web_search 内置工具：可插拔搜索后端 ──
# 后端选择：ddg（默认，免 Key，需可选依赖 pip install "milu[ddg]"）/ tavily / bocha
# WEB_SEARCH_PROVIDER=tavily

# Tavily 后端（WEB_SEARCH_PROVIDER=tavily 时必填）
# TAVILY_API_KEY=tvly-xxx

# 博查 Bocha 后端（WEB_SEARCH_PROVIDER=bocha 时必填）
# BOCHA_API_KEY=sk-xxx

# 自定义通用搜索 API（两项同时配置才生效，优先级高于 WEB_SEARCH_PROVIDER）
# SEARCH_API_URL=https://your-search-api.example.com/search
# SEARCH_API_KEY=xxx

# ── 3. 框架行为（目录与进程级开关）──
# 用户级「写数据」目录（默认 ~/.milu，存放 sessions/、记忆、用户级 config.json 等）
# MILU_HOME=D:/data/milu

# 项目级「读配置」目录（默认 CWD，config/milu.json、config/mcp_servers.json 从这里找）
# MILU_PROJECT_DIR=D:/MyWork/my-agent

# MCP 服务器配置文件的绝对路径（不配则按默认路径搜索）
# MCP_CONFIG_PATH=D:/MyWork/my-agent/config/mcp_servers.json

# 作为库被宿主应用集成时，关闭框架对 .env 的自动加载（改由宿主管理环境变量）。
# ⚠️ 该变量须设在「进程环境变量」中才有效——写在 .env 里无意义（框架读它
#    发生在加载 .env 之前），此处仅作说明。
# MILU_NO_DOTENV=1

# ── 3.5 微信客服接入（经企业微信，channels/wechat_kf）──
# 部署成微信客服时配置。前 4 项必填，从企业微信管理后台「微信客服 → API」获取：
#   - CORP_ID：企业 ID
#   - SECRET：「微信客服」的 Secret（务必用客服那个，不是其他应用）
#   - TOKEN / AESKEY：回调配置里你自己填的 Token 与 EncodingAESKey（43 位）
# WECHAT_KF_CORP_ID=ww1234567890abcdef
# WECHAT_KF_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WECHAT_KF_TOKEN=your_callback_token
# WECHAT_KF_AESKEY=43位EncodingAESKey
# 回调路径（选填，默认 /wechat/kf/callback）
# WECHAT_KF_CALLBACK_PATH=/wechat/kf/callback

# ── 3.6 飞书（Lark）接入（channels/feishu）──
# 部署成飞书机器人时配置。从飞书开放平台「开发者后台 → 应用 → 凭证与基础信息」拿
# APP_ID/APP_SECRET；「事件订阅」处填 VERIFY_TOKEN（Verification Token）、可选
# ENCRYPT_KEY（配了则回调走密文）。把回调 URL 指向 https://<域名>/feishu/event。
# FEISHU_APP_ID=cli_xxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_VERIFY_TOKEN=your_verification_token
# FEISHU_ENCRYPT_KEY=your_encrypt_key            # 选填（启用事件加密时）
# FEISHU_CALLBACK_PATH=/feishu/event             # 选填，默认 /feishu/event
# FEISHU_API_BASE=https://open.feishu.cn         # 选填；国际版 Lark 用 open.larksuite.com

# ── 3.7 Telegram 接入（channels/telegram，长轮询，无回调）──
# 从 @BotFather 创建机器人拿 token。国内服务器连不上官方域名时，用 TELEGRAM_API_BASE
# 指向代理或自建 Bot API Server。
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# TELEGRAM_API_BASE=https://api.telegram.org     # 选填，默认官方域名

# ── 4. 多租户 API Key 隔离（KeyedLLMProvider，业务侧自定义约定）──
# examples/multi_tenant_keys.py 演示的「按租户读环境变量」约定：TENANT_KEY_{租户大写}。
# 生产环境建议改用密钥管理服务（Vault、云 KMS），勿把租户 Key 留在明文文件中。
# TENANT_KEY_ACME=sk-xxx
# TENANT_KEY_GLOBEX=sk-xxx
